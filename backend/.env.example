# Copy this file to ".env" and fill in real values. Never commit ".env" itself.

# Port the backend server listens on
PORT=4000

# MongoDB Atlas connection string (we'll fill this in during the MongoDB step)
MONGODB_URI=

# Secret used to sign JWT auth tokens — use a long random string, not a real word
JWT_SECRET=

# URL the frontend runs on, so the backend can allow it through CORS
FRONTEND_ORIGIN=http://localhost:5173
