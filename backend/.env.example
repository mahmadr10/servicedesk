# Copy this file to ".env" and fill in real values. Never commit ".env" itself.

NODE_ENV=development

# Port the backend server listens on
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=

# Secret used to sign short-lived JWT access tokens — use a long random string
JWT_ACCESS_SECRET=

# Name of the httpOnly cookie the refresh token is stored in (rarely needs changing)
JWT_REFRESH_COOKIE_NAME=refreshToken

# URL the frontend runs on, so the backend can allow it through CORS
FRONTEND_ORIGIN=http://localhost:5173

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- OpenTelemetry (all optional — sensible defaults if left unset) ---

# Set to "false" to disable tracing/metrics entirely (e.g. a constrained CI runner)
OTEL_ENABLED=true

# Where to export traces via OTLP/HTTP, e.g. a local Jaeger instance's
# receiver. Leave UNSET to print spans to the console instead — no collector
# required. docker-compose.yml sets this automatically to the bundled Jaeger
# service, so `docker compose up` gets a full trace UI with zero setup.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Port the Prometheus metrics endpoint (/metrics) listens on
OTEL_METRICS_PORT=9464

OTEL_SERVICE_NAME=servicedesk-backend

# --- AI ticket assistant (optional bonus feature — all optional) ---

# Set to "false" to force the deterministic mock analyzer even if a key is set
AI_ENABLED=true

# Groq API key (https://console.groq.com/keys) — leave unset and the app
# automatically falls back to a deterministic mock analyzer, so the AI
# Assist feature (and the whole app) works with zero API key.
# GROQ_API_KEY=

# Any Groq-hosted chat model that supports structured output — check
# https://api.groq.com/openai/v1/models (with your key) for the current
# lineup, it changes over time.
AI_MODEL=openai/gpt-oss-120b
