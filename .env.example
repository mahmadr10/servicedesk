# Optional overrides for `docker compose up` — copy to ".env" in this same
# root folder if you want to change any of these. Every value has a working
# default (see docker-compose.yml), so this file is NOT required just to
# run the project with Docker.
#
# This is separate from backend/.env.example and frontend/.env.example,
# which are for running each half directly with `npm run dev` (no Docker).

# Use a real MongoDB Atlas connection string instead of the local mongo
# container that ships in docker-compose.yml:
# MONGODB_URI=mongodb+srv://...

# Use a real random secret instead of the insecure default (required if you
# ever run this compose file somewhere other than your own machine):
# JWT_ACCESS_SECRET=

# Only needed if you're not using the default published ports (8080/4000):
# FRONTEND_ORIGIN=http://localhost:8080
# VITE_API_URL=http://localhost:4000/api/v1
# VITE_SOCKET_URL=http://localhost:4000
